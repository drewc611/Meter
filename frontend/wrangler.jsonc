{
  // Cloudflare Workers static-assets deploy config. Committed on purpose --
  // without this, "wrangler versions upload" (the command Cloudflare's
  // Workers Builds runs for non-production/PR-branch deploys) fails with
  // "Missing entry-point to Worker script or to assets directory": it has
  // no auto-detection the way "wrangler deploy" (the production-branch
  // command) does. This is the one file both commands can rely on.
  //
  // "directory" points at Vite's build output, not the source tree -- the
  // dashboard is now a Vite/React app (see src/). "build.command" below is
  // wrangler's own pre-deploy hook: running `wrangler deploy` or `wrangler
  // versions upload` directly (locally, or from a plain CI job) runs
  // `npm run build` first automatically. It does NOT cover Cloudflare's
  // git-integration "Workers Builds" product specifically -- per Cloudflare's
  // docs, Workers Builds does not honor this "Custom Builds" wrangler config
  // and needs its own Build command set in the dashboard (Settings -> Build
  // -> Build command: npm run build, Build output directory: dist). See
  // DEPLOY.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meter",
  "compatibility_date": "2026-08-09",
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "dist"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
